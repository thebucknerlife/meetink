<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.meetink.app</string>
    <key>CFBundleName</key>
    <string>Meetink</string>
    <key>CFBundleDisplayName</key>
    <string>Meetink</string>
    <key>CFBundleExecutable</key>
    <string>meetink-app</string>
    <key>CFBundleIconFile</key>
    <string>Meetink</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <!-- Menubar app: no Dock icon, but windows still display. -->
    <key>LSUIElement</key>
    <true/>
    <!-- Shown by macOS when the app's Start Recording spawns the capture
         binary: TCC attributes the mic to the responsible (spawning) app,
         which is this bundle when recording starts from the menu bar. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Meetink records your microphone to transcribe your meetings when you start a recording from the menu bar.</string>
</dict>
</plist>
